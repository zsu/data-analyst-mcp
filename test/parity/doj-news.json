{
 "sample": {
  "description": "DOJ press releases with fentanyl in the title on 2 June 2025; one release in full; blog entries since 2025",
  "requests": [
   {
    "name": "fentanyl_june_2025",
    "endpoint": "press_releases",
    "params": {
     "parameters[title]": "\"fentanyl\"",
     "parameters[date]": "2025-06-02"
    }
   },
   {
    "name": "one_release",
    "endpoint": "press_release",
    "params": {
     "uuid": "2715a413-eb10-4d71-b4fd-9fd3e3eb0c0a",
     "fields": "uuid,title,date,component,topic,url,body"
    }
   },
   {
    "name": "blog_since",
    "endpoint": "blog_entries",
    "params": {
     "since": "2025-01-01"
    },
    "max_rows": 3
   }
  ]
 },
 "pre_2013": {
  "description": "Releases with 'sentenced' in the title on 26 November 2012",
  "requests": [
   {
    "name": "sentenced_2012_11_26",
    "endpoint": "press_releases",
    "params": {
     "parameters[title]": "sentenced",
     "parameters[date]": "2012-11-26"
    }
   }
  ]
 },
 "time_tags": {
  "description": "Releases with 'Office' in the title on 14 March 2024, with web-publishing times",
  "requests": [
   {
    "name": "office_2024_03_14",
    "endpoint": "press_releases",
    "params": {
     "parameters[title]": "Office",
     "parameters[date]": "2024-03-14",
     "fields": "uuid,title,date,created,changed,component,topic,url"
    }
   }
  ]
 }
}
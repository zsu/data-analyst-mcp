{
 "_parity": {
  "keys": false
 },
 "sample": {
  "description": "Metformin adverse-event reports received in 2024: top reactions; Class I food recalls reported in January 2024",
  "requests": [
   {
    "name": "metformin_reactions_2024",
    "endpoint": "count",
    "params": {
     "dataset": "drug_event",
     "search": "patient.drug.openfda.generic_name.exact:\"METFORMIN HYDROCHLORIDE\" AND receivedate:[20240101 TO 20241231]",
     "count": "patient.reaction.reactionmeddrapt.exact",
     "limit": 10
    }
   },
   {
    "name": "food_recalls_class1",
    "endpoint": "search",
    "max_rows": 5,
    "params": {
     "dataset": "food_enforcement",
     "search": "classification:\"Class I\" AND report_date:[20240101 TO 20240131]",
     "sort": "report_date:asc"
    }
   }
  ]
 },
 "no_match_allowed": {
  "description": "no match",
  "requests": [
   {
    "name": "none",
    "endpoint": "search",
    "max_rows": 5,
    "params": {
     "dataset": "drug_enforcement",
     "search": "recalling_firm:\"ZZQXNOFIRM\""
    },
    "allow_empty": true
   }
  ]
 }
}
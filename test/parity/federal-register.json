{
 "fetch": {
  "description": "Executive orders published in 2024 (Biden) and EPA final rules per year",
  "requests": [
   {
    "name": "eo_2024",
    "endpoint": "executive_orders",
    "params": {
     "conditions[president][]": "joe-biden",
     "conditions[publication_date][year]": "2024"
    }
   },
   {
    "name": "epa_rules_by_year",
    "endpoint": "document_counts",
    "params": {
     "facet": "yearly",
     "conditions[type][]": "RULE",
     "conditions[agencies][]": "environmental-protection-agency"
    }
   }
  ]
 }
}
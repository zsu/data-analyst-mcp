{
 "sample": {
  "description": "Industry payments to Vermont recipients, program year 2024: state totals and Pfizer general payments",
  "requests": [
   {
    "name": "vt_totals_2024",
    "endpoint": "query",
    "params": {
     "dataset": "state_totals",
     "where": {
      "state_code": "VT",
      "program_year": "2024"
     },
     "columns": [
      "state_code",
      "program_year",
      "payment_type",
      "recipient_type",
      "total_number_of_physicians",
      "total_payment_amount_physician",
      "total_payment_count_physician"
     ]
    }
   },
   {
    "name": "vt_pfizer_2024",
    "endpoint": "query",
    "params": {
     "dataset": "general_2024",
     "where": {
      "recipient_state": "VT"
     },
     "conditions": [
      {
       "property": "applicable_manufacturer_or_applicable_gpo_making_payment_name",
       "value": "%pfizer%",
       "operator": "LIKE"
      }
     ],
     "columns": [
      "record_id",
      "covered_recipient_type",
      "recipient_city",
      "applicable_manufacturer_or_applicable_gpo_making_payment_name",
      "total_amount_of_payment_usdollars",
      "date_of_payment",
      "nature_of_payment_or_transfer_of_value"
     ]
    }
   }
  ]
 }
}